<event type="Sequence">
	<meter-list timeout="15" units="Seconds">
		<output filename="robotlogs/eventsfile.txt" append="False"/>
		<meter>Video-Used-Memory</meter>
		<meter>Video-Free-Memory</meter>
		<meter>Video-Total-Memory</meter>
		<meter>Used-Memory</meter>
		<meter>Free-Memory</meter>
		<meter>Total-Memory</meter>
		<meter>File-Buffer-Cache</meter>
		<meter>Page-Cache</meter>
		<meter>Real-Free-Memory</meter>
		<meter>CMR</meter>
		<meter>Max-CMR</meter>
		<meter>Sys-CPU</meter>
		<meter>User-CPU</meter>
		<meter>Idle-CPU</meter>
		<meter>Games-Played</meter>
		<meter>Turnover</meter>
		<meter>Total-Win</meter>
		<meter>Credit</meter>
		<meter>Bet</meter>
		<meter>Last-Win</meter>
		<meter>Hopper-Pay</meter>
		<meter>Jackpot</meter>
	</meter-list>
	<!-- Helix Standard — game switching loop -->
	<event type="Sequence">
		<!-- choose denomination -->
		<event type="Random">
			<event type="Touch-Screen" weight="40">
				<point x="765" y="740"/>
			</event>
			<event type="Touch-Screen" weight="40">
				<point x="950" y="740"/>
			</event>
			<event type="Touch-Screen" weight="40">
				<point x="1150" y="740"/>
			</event>
		</event>
		<event type="Wait" id="Wait for idle" state="Game-Idle" timeout="3" units="Seconds"/>
		<!-- confirm game switch (95% yes, 5% no) -->
		<event type="Random">
			<!-- yes / confirm -->
			<event type="Touch-Screen" weight="95">
				<point x="870" y="595"/>
			</event>
			<!-- no / cancel -->
			<event type="Touch-Screen" weight="5">
				<point x="1050" y="595"/>
			</event>
		</event>
		<event type="Wait" id="Wait for idle" state="Game-Idle" timeout="2" units="Seconds"/>
		<!-- touch games menu — return to lobby -->
		<event type="Touch-Screen" weight="500">
			<point x="150" y="940"/>
		</event>
		<event type="Wait" id="Wait for idle" state="Game-Idle" timeout="3" units="Seconds"/>
	</event>
	<event type="Insert-Credit" value="2048" when-below="512"/>
	<event type="Clear-Jackpot"/>
	<output filename="robotlogs/eventsfile.txt" append="False"/>
</event>
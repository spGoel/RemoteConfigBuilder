<event type="Sequence">
	<meter-list timeout="15" units="Seconds">
		<output filename="robotlogs/eventsfile.txt" append="False"/>
		<meter>Video-Used-Memory</meter>
		<meter>Video-Free-Memory</meter>
		<meter>Video-Total-Memory</meter>
		<meter>Used-Memory</meter>
		<meter>Free-Memory</meter>
		<meter>Total-Memory</meter>
		<meter>File-Buffer-Cache</meter>
		<meter>Page-Cache</meter>
		<meter>Real-Free-Memory</meter>
		<meter>CMR</meter>
		<meter>Max-CMR</meter>
		<meter>Sys-CPU</meter>
		<meter>User-CPU</meter>
		<meter>Idle-CPU</meter>
		<meter>Games-Played</meter>
		<meter>Turnover</meter>
		<meter>Total-Win</meter>
		<meter>Credit</meter>
		<meter>Bet</meter>
		<meter>Last-Win</meter>
		<meter>Hopper-Pay</meter>
		<meter>Jackpot</meter>
	</meter-list>
	<!-- SGMD GAMPRO Helix — denom + UPI + gamble -->
	<event type="Sequence">
		<!-- choose denomination -->
		<event type="Random">
			<event type="Touch-Screen" weight="40">
				<point x="763" y="725"/>
			</event>
			<event type="Touch-Screen" weight="40">
				<point x="958" y="720"/>
			</event>
			<event type="Touch-Screen" weight="40">
				<point x="1150" y="728"/>
			</event>
		</event>
		<event type="Wait" id="Wait for idle" state="Game-Idle" timeout="3" units="Seconds"/>
		<!-- UPI buttons in denom screen -->
		<event type="Random">
			<!-- language switch -->
			<event type="Touch-Screen" weight="40">
				<point x="130" y="965"/>
			</event>
			<!-- volume -->
			<event type="Touch-Screen" weight="40">
				<point x="45" y="1030"/>
			</event>
			<!-- game rules -->
			<event type="Touch-Screen" weight="40">
				<point x="130" y="1070"/>
			</event>
		</event>
		<event type="Button" key="Play"/>
		<event type="Wait" id="Wait for idle" state="Game-Idle" timeout="3" units="Seconds"/>
		<!-- take win or gamble -->
		<event type="Random">
			<!-- take win -->
			<event type="Touch-Screen" weight="40">
				<point x="1800" y="890"/>
			</event>
			<!-- gamble sequence -->
			<event type="Sequence" weight="50">
				<!-- gamble button -->
				<event type="Touch-Screen">
					<point x="1800" y="800"/>
				</event>
				<!-- choose card colour or take win -->
				<event type="Random">
					<!-- black -->
					<event type="Touch-Screen" weight="40">
						<point x="1400" y="600"/>
					</event>
					<!-- red -->
					<event type="Touch-Screen" weight="40">
						<point x="525" y="600"/>
					</event>
					<!-- heart -->
					<event type="Touch-Screen" weight="40">
						<point x="425" y="720"/>
					</event>
					<!-- spade -->
					<event type="Touch-Screen" weight="40">
						<point x="1500" y="720"/>
					</event>
					<!-- diamond -->
					<event type="Touch-Screen" weight="40">
						<point x="620" y="720"/>
					</event>
					<!-- club -->
					<event type="Touch-Screen" weight="40">
						<point x="1300" y="720"/>
					</event>
					<!-- take win from gamble -->
					<event type="Touch-Screen" weight="40">
						<point x="1800" y="890"/>
					</event>
				</event>
			</event>
		</event>
		<event type="Wait" id="Wait for idle" state="Game-Idle" timeout="3" units="Seconds"/>
		<!-- touch games menu — return to lobby -->
		<event type="Touch-Screen" weight="500">
			<point x="1810" y="938"/>
		</event>
		<event type="Wait" id="Wait for idle" state="Game-Idle" timeout="3" units="Seconds"/>
		<!-- UPI buttons in lobby -->
		<event type="Random">
			<!-- language switch (lobby) -->
			<event type="Touch-Screen" weight="40">
				<point x="1800" y="1055"/>
			</event>
			<!-- volume (lobby) -->
			<event type="Touch-Screen" weight="40">
				<point x="1480" y="1055"/>
			</event>
			<!-- game rules (lobby) -->
			<event type="Touch-Screen" weight="40">
				<point x="1350" y="1055"/>
			</event>
		</event>
		<event type="Wait" id="Wait for idle" state="Game-Idle" timeout="3" units="Seconds"/>
	</event>
	<event type="Insert-Credit" value="2048" when-below="512"/>
	<event type="Clear-Jackpot"/>
	<output filename="robotlogs/eventsfile.txt" append="False"/>
</event>